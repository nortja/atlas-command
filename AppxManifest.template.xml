<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
 xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
 xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
 xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
 IgnorableNamespaces="uap uap10 rescap">
 <Identity Name="{{IDENTITY_NAME}}" Publisher="{{IDENTITY_PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />
 <Properties>
  <DisplayName>{{DISPLAY_NAME}}</DisplayName><PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
  <Description>Private, local-first Earth exploration workspace</Description><Logo>StoreAssets\StoreLogo.png</Logo>
 </Properties>
 <Resources><Resource Language="en-US" /></Resources>
 <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="{{MAX_VERSION_TESTED}}" /></Dependencies>
 <Applications><Application Id="AtlasCommand" Executable="AtlasCommand.exe"
   uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
  <uap:VisualElements DisplayName="{{DISPLAY_NAME}}" Description="Private, local-first Earth exploration workspace"
    BackgroundColor="transparent" Square150x150Logo="StoreAssets\Square150x150Logo.png" Square44x44Logo="StoreAssets\Square44x44Logo.png" />
 </Application></Applications>
 <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
</Package>
